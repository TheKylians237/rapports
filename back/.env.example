# Copiez ce fichier vers .env (même répertoire) et remplacez les valeurs factices.
# Ne placez jamais de secrets réels dans ce fichier de modèle.

# Serveur HTTP
PORT=5000
HOST=0.0.0.0
# TRUST_PROXY : false par défaut ; derrière proxy, indiquez son IP/réseau de confiance exact.
# Ne mettez jamais la valeur "true" : elle permet de falsifier l’IP source de la liste blanche.
TRUST_PROXY=
# Origines autorisées pour CORS (séparées par des virgules)
APP_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Sécurité JWT
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Base de données MySQL/MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=rprts_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME=rprts

# Messagerie (Nodemailer)
DAILY_REPORT_REMINDER_HOUR=17
AUDIT_LOG_RETENTION_DAYS=365
SESSION_DURATION=8h
REMEMBERED_SESSION_DURATION=30d
MONTHLY_SUMMARY_HOUR=8
# Générer une paire VAPID durable avec `npx web-push generate-vapid-keys` puis la conserver dans cet environnement.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
WEBHOOK_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Pour Web Push/PWA sur le réseau local, fournir un certificat TLS approuvé par les appareils.
TLS_KEY_FILE=
TLS_CERT_FILE=
HTTPS_PORT=5000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-account@example.com
MAIL_PASSWORD=replace-with-the-mail-password-or-app-password
# Alias pour compatibilité avec certains fichiers de configuration
MAIL_PASS=
MAIL_FROM=your-account@example.com
